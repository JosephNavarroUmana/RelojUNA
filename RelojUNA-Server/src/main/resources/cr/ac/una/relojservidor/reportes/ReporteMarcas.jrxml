<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ReporteMarcas" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <field name="folioEmpleado" class="java.lang.String"/>
    <field name="nombreEmpleado" class="java.lang.String"/>
    <field name="fecha" class="java.time.LocalDate"/>
    <field name="horaEntrada" class="java.time.LocalTime"/>
    <field name="horaSalida" class="java.time.LocalTime"/>
    <field name="horasTrabajadas" class="java.lang.Double"/>

    <variable name="totalHorasEmpleado" class="java.lang.Double" resetType="Group" resetGroup="AgrupacionPorEmpleado" calculation="Sum">
        <expression><![CDATA[$F{horasTrabajadas}]]></expression>
    </variable>
    <variable name="totalHorasGeneral" class="java.lang.Double" resetType="Report" calculation="Sum">
        <expression><![CDATA[$F{horasTrabajadas}]]></expression>
    </variable>

    <style name="TitleStyle" fontSize="20" bold="true" forecolor="#2C3E50"/>
    <style name="SubtitleStyle" fontSize="9" forecolor="#7F8C8D" italic="true"/>
    <style name="HeaderStyle" fontSize="10" bold="true" forecolor="#FFFFFF"/>
    <style name="DetailStyle" fontSize="9" forecolor="#2C3E50"/>
    <style name="GroupStyle" fontSize="11" bold="true" forecolor="#FFFFFF"/>
    <style name="SubtotalStyle" fontSize="9" bold="true" forecolor="#2C3E50"/>
    <style name="TotalStyle" fontSize="12" bold="true" forecolor="#FFFFFF"/>

    <group name="AgrupacionPorEmpleado">
        <expression><![CDATA[$F{nombreEmpleado}]]></expression>
        <groupHeader>
            <band height="26">
                <element kind="rectangle" x="0" y="4" width="555" height="20" backcolor="#34495E">
                    <pen lineWidth="0"/>
                </element>
                <element kind="textField" style="GroupStyle" x="10" y="4" width="500" height="20" vTextAlign="Middle">
                    <expression><![CDATA["Empleado: " + $F{nombreEmpleado} + "  (Folio: " + $F{folioEmpleado} + ")"]]></expression>
                </element>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="22">
                <element kind="line" x="0" y="0" width="555" height="1">
                    <pen lineWidth="0.5" lineColor="#D5D8DC"/>
                </element>
                <element kind="textField" style="SubtotalStyle" x="300" y="4" width="245" height="16" hTextAlign="Right">
                    <expression><![CDATA["Subtotal horas: " + String.format("%.2f", $V{totalHorasEmpleado})]]></expression>
                </element>
            </band>
        </groupFooter>
    </group>

    <background splitType="Stretch"/>

    <title height="70" splitType="Stretch">
        <element kind="staticText" style="TitleStyle" x="0" y="10" width="555" height="30" hTextAlign="Center">
            <text><![CDATA[Reporte de Marcas]]></text>
        </element>
        <element kind="textField" style="SubtitleStyle" x="0" y="42" width="555" height="14" hTextAlign="Center">
            <expression><![CDATA["Generado el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></expression>
        </element>
        <element kind="line" x="0" y="64" width="555" height="1">
            <pen lineWidth="1.5" lineColor="#2C3E50"/>
        </element>
    </title>

    <pageHeader height="0" splitType="Stretch"/>

    <columnHeader height="24" splitType="Stretch">
        <element kind="rectangle" x="0" y="0" width="555" height="24" backcolor="#2C3E50">
            <pen lineWidth="0"/>
        </element>
        <element kind="staticText" style="HeaderStyle" x="10" y="0" width="110" height="24" vTextAlign="Middle">
            <text><![CDATA[Fecha]]></text>
        </element>
        <element kind="staticText" style="HeaderStyle" x="140" y="0" width="110" height="24" vTextAlign="Middle">
            <text><![CDATA[Hora Entrada]]></text>
        </element>
        <element kind="staticText" style="HeaderStyle" x="270" y="0" width="110" height="24" vTextAlign="Middle">
            <text><![CDATA[Hora Salida]]></text>
        </element>
        <element kind="staticText" style="HeaderStyle" x="400" y="0" width="145" height="24" vTextAlign="Middle" hTextAlign="Right">
            <text><![CDATA[Horas Trabajadas]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="22" splitType="Stretch">
            <element kind="textField" style="DetailStyle" x="10" y="3" width="110" height="16" vTextAlign="Middle" pattern="dd/MM/yyyy">
                <expression><![CDATA[$F{fecha}]]></expression>
            </element>
            <element kind="textField" style="DetailStyle" x="140" y="3" width="110" height="16" vTextAlign="Middle" pattern="HH:mm">
                <expression><![CDATA[$F{horaEntrada}]]></expression>
            </element>
            <element kind="textField" style="DetailStyle" x="270" y="3" width="110" height="16" vTextAlign="Middle" pattern="HH:mm">
                <expression><![CDATA[$F{horaSalida}]]></expression>
            </element>
            <element kind="textField" style="DetailStyle" x="400" y="3" width="145" height="16" vTextAlign="Middle" hTextAlign="Right">
                <expression><![CDATA[String.format("%.2f", $F{horasTrabajadas})]]></expression>
            </element>
            <element kind="line" x="0" y="21" width="555" height="1">
                <pen lineWidth="0.5" lineColor="#EAECEE"/>
            </element>
        </band>
    </detail>

    <columnFooter height="0" splitType="Stretch"/>
    <pageFooter height="24" splitType="Stretch">
        <element kind="line" x="0" y="0" width="555" height="1">
            <pen lineWidth="0.5" lineColor="#D5D8DC"/>
        </element>
        <element kind="textField" x="0" y="6" width="277" height="14" style="SubtitleStyle">
            <expression><![CDATA["RelojUNA - Reporte de Marcas"]]></expression>
        </element>
        <element kind="textField" x="277" y="6" width="278" height="14" style="SubtitleStyle" hTextAlign="Right">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>

    <summary height="36" splitType="Stretch">
        <element kind="rectangle" x="0" y="4" width="555" height="26" backcolor="#2C3E50">
            <pen lineWidth="0"/>
        </element>
        <element kind="textField" style="TotalStyle" x="10" y="4" width="535" height="26" vTextAlign="Middle" hTextAlign="Right">
            <expression><![CDATA["Total general de horas: " + String.format("%.2f", $V{totalHorasGeneral})]]></expression>
        </element>
    </summary>
</jasperReport>
