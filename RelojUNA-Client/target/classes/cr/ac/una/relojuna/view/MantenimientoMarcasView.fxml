<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.relojuna.controller.MantenimientoMarcasController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Mantenimiento de Marcas" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Fecha desde:" />
        <DatePicker fx:id="dpFechaDesde" />
        <Label text="Fecha hasta:" />
        <DatePicker fx:id="dpFechaHasta" />
        <Button fx:id="btnFiltrar" onAction="#handleFiltrar" text="Filtrar" />
        <Button fx:id="btnVerInconsistencias" onAction="#handleVerInconsistencias" text="Ver Inconsistencias" />
        <Label fx:id="lblCantInconsistencias" text="Inconsistencias: 0" />
        <Button fx:id="btnSiguienteInconsistencia" onAction="#handleSiguienteInconsistencia" text="Siguiente ›" />
    </HBox>

    <TableView fx:id="tblMarcas" prefHeight="300">
        <columns>
            <TableColumn fx:id="colEmpleado" prefWidth="120" text="Empleado" />
            <TableColumn fx:id="colFechaHora" prefWidth="150" text="Fecha / Hora" />
            <TableColumn fx:id="colTipo" prefWidth="80" text="Tipo" />
            <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="btnAgregar" onAction="#handleAgregar" text="Agregar Marca" />
        <Button fx:id="btnModificar" onAction="#handleModificar" text="Modificar" />
        <Button fx:id="btnEliminar" onAction="#handleEliminar" text="Eliminar" />
        <Button fx:id="btnCorregirInconsistencia" onAction="#handleCorregirInconsistencia" text="Corregir Seleccionada" />
    </HBox>
</VBox>