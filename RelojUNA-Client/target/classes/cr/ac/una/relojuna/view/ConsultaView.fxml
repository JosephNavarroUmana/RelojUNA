<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="vista-root,ventana-modulo" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.relojuna.controller.ConsultaController">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="app-header">
            <Label styleClass="app-header-titulo" text="RelojUNA" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="app-header-usuario" text="Consultas de Marcas (Streams)" />
            <Button fx:id="btnRegresar" onAction="#handleRegresar" styleClass="boton-header" text="Regresar" />
        </HBox>
    </top>

    <center>
        <VBox styleClass="contenedor-modulo">

            <HBox styleClass="panel-tarjeta,barra-filtros">
                <Label styleClass="etiqueta-campo" text="Fecha desde:" />
                <DatePicker fx:id="dpFechaDesde" />
                <Label styleClass="etiqueta-campo" text="Fecha hasta:" />
                <DatePicker fx:id="dpFechaHasta" />
                <Label styleClass="etiqueta-campo" text="Empleado:" />
                <ComboBox fx:id="cmbEmpleado" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="barra-botones">
                <Button fx:id="btnConsultar" onAction="#handleConsultar" styleClass="boton-primario" text="Consultar" />
                <Button fx:id="btnExportarExcel" onAction="#handleExportarExcel" styleClass="boton-secundario" text="Exportar a Excel" />
            </HBox>

            <HBox styleClass="panel-tarjeta,panel-resumen">
                <VBox styleClass="bloque-resumen">
                    <Label styleClass="etiqueta-resumen" text="Total empleados" />
                    <Label fx:id="lblTotalEmpleados" styleClass="valor-resumen" text="0" />
                </VBox>
                <VBox styleClass="bloque-resumen">
                    <Label styleClass="etiqueta-resumen" text="Total marcas" />
                    <Label fx:id="lblTotalMarcas" styleClass="valor-resumen" text="0" />
                </VBox>
                <VBox styleClass="bloque-resumen">
                    <Label styleClass="etiqueta-resumen" text="Total horas trabajadas" />
                    <Label fx:id="lblTotalHoras" styleClass="valor-resumen" text="0.0" />
                </VBox>
            </HBox>

            <TableView fx:id="tblResultados" styleClass="tabla-datos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colEmpleado" prefWidth="150" text="Empleado" />
                    <TableColumn fx:id="colFecha" prefWidth="100" text="Fecha" />
                    <TableColumn fx:id="colHoraEntrada" prefWidth="100" text="Hora Entrada" />
                    <TableColumn fx:id="colHoraSalida" prefWidth="100" text="Hora Salida" />
                    <TableColumn fx:id="colHorasTrabajadas" prefWidth="120" text="Horas Trabajadas" />
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>