<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.relojuna.controller.MarcaController">
    <top>
        <VBox alignment="CENTER" spacing="10">
            <Label fx:id="lblReloj" text="00:00:00" style="-fx-font-size: 40px;"/>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20">
            <TextField fx:id="txtFolioMarca" promptText="Ingrese su Folio para marcar"/>
            <Button text="Marcar Entrada/Salida" onAction="#onMarcar"/>
            <Label fx:id="lblMensaje" text="Esperando marca..."/>
            <ImageView fx:id="imgEmpleado" fitHeight="150" fitWidth="150" preserveRatio="true"/>
        </VBox>
    </center>
</BorderPane>
