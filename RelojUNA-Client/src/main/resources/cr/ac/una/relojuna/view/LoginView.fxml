<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" styleClass="fondo-app" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.relojuna.controller.LoginController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #26456b;" text="Inicio de Sesion - Reloj Marcador" />

    <VBox alignment="CENTER" maxWidth="320" spacing="15" styleClass="panel-tarjeta">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="etiqueta-campo" text="Folio:" />
            <TextField fx:id="txtFolio" promptText="Ingrese su folio" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="etiqueta-campo" text="Clave:" />
            <PasswordField fx:id="txtClave" promptText="Ingrese su clave" HBox.hgrow="ALWAYS" />
        </HBox>

        <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#handleLogin" styleClass="boton-primario" text="Ingresar" />
    </VBox>

    <Label fx:id="lblMensaje" styleClass="mensaje-error" text="" />
</VBox>
