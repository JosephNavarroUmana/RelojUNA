<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.relojuna.controller.ConsultaController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Consultas de Marcas (Streams)" />

    <GridPane alignment="CENTER_LEFT" hgap="10" vgap="10">
        <Label text="Fecha desde:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <DatePicker fx:id="dpFechaDesde" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Fecha hasta:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <DatePicker fx:id="dpFechaHasta" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Empleado:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="cmbEmpleado" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Button fx:id="btnConsultar" onAction="#handleConsultar" text="Consultar" />
            <Button fx:id="btnExportarExcel" onAction="#handleExportarExcel" text="Exportar a Excel" />
        </HBox>
    </GridPane>

    <!-- Resumen estadístico -->
    <HBox spacing="20">
        <Label fx:id="lblTotalEmpleados" text="Total empleados: 0" />
        <Label fx:id="lblTotalMarcas" text="Total marcas: 0" />
        <Label fx:id="lblTotalHoras" text="Total horas trabajadas: 0.0" />
    </HBox>

    <TableView fx:id="tblResultados" prefHeight="300">
        <columns>
            <TableColumn fx:id="colEmpleado" prefWidth="150" text="Empleado" />
            <TableColumn fx:id="colFecha" prefWidth="100" text="Fecha" />
            <TableColumn fx:id="colHoraEntrada" prefWidth="100" text="Hora Entrada" />
            <TableColumn fx:id="colHoraSalida" prefWidth="100" text="Hora Salida" />
            <TableColumn fx:id="colHorasTrabajadas" prefWidth="120" text="Horas Trabajadas" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnRegresar" onAction="#handleRegresar" text="Regresar" />
    </HBox>
</VBox>