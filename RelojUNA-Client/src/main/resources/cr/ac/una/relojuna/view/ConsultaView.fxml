<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="fondo-app" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.relojuna.controller.ConsultaController">

    <top>
        <VBox styleClass="barra-titulo">
            <Label styleClass="titulo-pantalla" text="Consultas de Marcas (Streams)" />
        </VBox>
    </top>

    <center>
        <VBox spacing="15" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="etiqueta-campo" text="Fecha desde:" />
                <DatePicker fx:id="dpFechaDesde" />
                <Label styleClass="etiqueta-campo" text="Fecha hasta:" />
                <DatePicker fx:id="dpFechaHasta" />
                <Label styleClass="etiqueta-campo" text="Empleado:" />
                <ComboBox fx:id="cmbEmpleado" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox spacing="10">
                <Button fx:id="btnConsultar" onAction="#handleConsultar" styleClass="boton-primario" text="Consultar" />
                <Button fx:id="btnExportarExcel" onAction="#handleExportarExcel" styleClass="boton-secundario" text="Exportar a Excel" />
            </HBox>

            <HBox spacing="25" styleClass="panel-tarjeta">
                <Label fx:id="lblTotalEmpleados" text="Total empleados: 0" />
                <Label fx:id="lblTotalMarcas" text="Total marcas: 0" />
                <Label fx:id="lblTotalHoras" text="Total horas trabajadas: 0.0" />
            </HBox>

            <TableView fx:id="tblResultados" styleClass="tabla-datos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colEmpleado" prefWidth="150" text="Empleado" />
                    <TableColumn fx:id="colFecha" prefWidth="100" text="Fecha" />
                    <TableColumn fx:id="colHoraEntrada" prefWidth="100" text="Hora Entrada" />
                    <TableColumn fx:id="colHoraSalida" prefWidth="100" text="Hora Salida" />
                    <TableColumn fx:id="colHorasTrabajadas" prefWidth="120" text="Horas Trabajadas" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="barra-botones">
            <padding>
                <Insets bottom="15" left="20" right="20" top="0" />
            </padding>
            <Button fx:id="btnRegresar" onAction="#handleRegresar" styleClass="boton-secundario" text="Regresar" />
        </HBox>
    </bottom>

</BorderPane>