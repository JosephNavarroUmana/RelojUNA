<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ReporteMarcas" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<field name="folioEmpleado" class="java.lang.Integer"/>
	<field name="nombreEmpleado" class="java.lang.String"/>
	<field name="fecha" class="java.time.LocalDate"/>
	<field name="horaEntrada" class="java.time.LocalTime"/>
	<field name="horaSalida" class="java.time.LocalTime"/>
	<field name="horasTrabajadas" class="java.lang.Double"/>
	<variable name="totalHorasEmpleado" class="java.lang.Double" resetType="Group" resetGroup="AgrupacionPorEmpleado" calculation="Sum">
		<expression><![CDATA[$F{horasTrabajadas}]]></expression>
	</variable>
	<variable name="totalHorasGeneral" class="java.lang.Double" resetType="Report" calculation="Sum">
		<expression><![CDATA[$F{horasTrabajadas}]]></expression>
	</variable>
	<group name="AgrupacionPorEmpleado">
		<expression><![CDATA[$F{nombreEmpleado}]]></expression>
		<groupHeader>
			<band height="25">
				<element kind="textField" x="0" y="5" width="300" height="20">
					<expression><![CDATA["Empleado: " + $F{nombreEmpleado}]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="25">
				<element kind="textField" x="0" y="0" width="300" height="20">
					<expression><![CDATA["Subtotal horas: " + $V{totalHorasEmpleado}]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
	<background splitType="Stretch"/>
	<title height="60" splitType="Stretch">
		<element kind="staticText" x="180" y="20" width="200" height="30">
			<text><![CDATA[Reporte de Marcas]]></text>
		</element>
	</title>
	<pageHeader height="0" splitType="Stretch"/>
	<columnHeader height="20" splitType="Stretch">
		<element kind="staticText" x="0" y="0" width="90" height="15">
			<text><![CDATA[Fecha]]></text>
		</element>
		<element kind="staticText" x="100" y="0" width="90" height="15">
			<text><![CDATA[Hora Entrada]]></text>
		</element>
		<element kind="staticText" x="200" y="0" width="90" height="15">
			<text><![CDATA[Hora Salida]]></text>
		</element>
		<element kind="staticText" x="300" y="0" width="100" height="15">
			<text><![CDATA[Horas Trabajadas]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="20" splitType="Stretch">
			<element kind="textField" x="0" y="0" width="90" height="15">
				<expression><![CDATA[$F{fecha}.toString()]]></expression>
			</element>
			<element kind="textField" x="100" y="0" width="90" height="15">
				<expression><![CDATA[$F{horaEntrada}.toString()]]></expression>
			</element>
			<element kind="textField" x="200" y="0" width="90" height="15">
				<expression><![CDATA[$F{horaSalida}.toString()]]></expression>
			</element>
			<element kind="textField" x="300" y="0" width="100" height="15">
				<expression><![CDATA[$F{horasTrabajadas}]]></expression>
			</element>
		</band>
	</detail>
	<columnFooter height="0" splitType="Stretch"/>
	<pageFooter height="0" splitType="Stretch"/>
	<summary height="30" splitType="Stretch">
		<element kind="textField" x="0" y="5" width="300" height="20">
			<expression><![CDATA["Total general de horas: " + $V{totalHorasGeneral}]]></expression>
		</element>
	</summary>
</jasperReport>