<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" styleClass="fondo-app" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.relojuna.controller.MarcaController">
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #26456b;" text="Pantalla de Marcas" />

    <Label fx:id="lblReloj" styleClass="reloj-digital" text="00:00:00" />

    <HBox alignment="CENTER" maxWidth="450" spacing="10" styleClass="panel-tarjeta">
        <Label styleClass="etiqueta-campo" text="Folio del empleado:" />
        <TextField fx:id="txtFolio" promptText="Ingrese su folio" HBox.hgrow="ALWAYS" />
        <Button fx:id="btnMarcar" onAction="#handleMarcar" styleClass="boton-primario" text="Marcar" />
    </HBox>

    <VBox alignment="CENTER" spacing="10">
        <ImageView fx:id="imgFoto" fitHeight="100" fitWidth="100" preserveRatio="true" />
        <Label fx:id="lblNombreEmpleado" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="" />
        <Label fx:id="lblHoraMarca" style="-fx-font-size: 14px;" text="" />
        <Label fx:id="lblMensaje" styleClass="mensaje-exito" text="" />
    </VBox>

    <HBox alignment="CENTER_RIGHT" maxWidth="450" spacing="10">
        <Button fx:id="btnRegresar" onAction="#handleRegresar" styleClass="boton-secundario" text="Regresar" />
    </HBox>
</VBox>