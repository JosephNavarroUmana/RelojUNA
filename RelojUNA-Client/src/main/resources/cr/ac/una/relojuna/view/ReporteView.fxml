<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="fondo-app" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.relojuna.controller.ReporteController">

    <top>
        <VBox styleClass="barra-titulo">
            <Label styleClass="titulo-pantalla" text="Modulo de Reportes (Jasper Reports)" />
        </VBox>
    </top>

    <center>
        <VBox maxWidth="500" spacing="20" styleClass="panel-tarjeta" BorderPane.alignment="TOP_CENTER">
            <padding>
                <Insets bottom="15" left="20" right="20" top="20" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label styleClass="etiqueta-campo" text="Tipo de reporte:" />
                <RadioButton fx:id="rbReporteEmpleados" text="Empleados" />
                <RadioButton fx:id="rbReporteMarcas" selected="true" text="Marcas" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="etiqueta-campo" text="Empleado:" />
                <ComboBox fx:id="cmbEmpleado" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="etiqueta-campo" text="Fecha desde:" />
                <DatePicker fx:id="dpFechaDesde" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="etiqueta-campo" text="Fecha hasta:" />
                <DatePicker fx:id="dpFechaHasta" />
            </HBox>

            <HBox spacing="10" styleClass="barra-botones">
                <Button fx:id="btnGenerarReporte" onAction="#handleGenerarReporte" styleClass="boton-primario" text="Generar Reporte" />
                <Button fx:id="btnVistaPrevia" onAction="#handleVistaPrevia" styleClass="boton-secundario" text="Vista Previa" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="barra-botones">
            <padding>
                <Insets bottom="15" left="20" right="20" top="0" />
            </padding>
            <Button fx:id="btnRegresar" onAction="#handleRegresar" styleClass="boton-secundario" text="Regresar" />
        </HBox>
    </bottom>

</BorderPane>