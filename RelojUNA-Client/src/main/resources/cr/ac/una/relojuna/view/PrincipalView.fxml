<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="25" styleClass="fondo-app" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.relojuna.controller.PrincipalController">
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <VBox alignment="CENTER" spacing="5">
        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #26456b;" text="Menu Principal - Reloj Marcador" />
        <Label fx:id="lblUsuario" style="-fx-font-size: 14px; -fx-text-fill: #555555;" text="Bienvenido: " />
    </VBox>

    <FlowPane alignment="CENTER" hgap="20" prefWrapLength="500" vgap="20">
        <Button fx:id="btnEmpleados" onAction="#handleEmpleados" styleClass="menu-boton" text="Mantenimiento de Empleados" />
        <Button fx:id="btnMarcas" onAction="#handleMarcas" styleClass="menu-boton" text="Pantalla de Marcas" />
        <Button fx:id="btnMantenimientoMarcas" onAction="#handleMantenimientoMarcas" styleClass="menu-boton" text="Mantenimiento de Marcas" />
        <Button fx:id="btnPlanilla" onAction="#handlePlanilla" styleClass="menu-boton" text="Generacion de Planillas" />
        <Button fx:id="btnConsulta" onAction="#handleConsulta" styleClass="menu-boton" text="Consultas (Streams)" />
        <Button fx:id="btnReportes" onAction="#handleReportes" styleClass="menu-boton" text="Modulo de Reportes" />
    </FlowPane>

    <Button fx:id="btnCerrarSesion" onAction="#handleCerrarSesion" styleClass="boton-peligro" text="Cerrar Sesion" />
</VBox>