<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="vista-root"
            stylesheets="@/cr/ac/una/relojuna/css/estilos.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.relojuna.controller.PrincipalController">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" styleClass="app-header">
                <Label styleClass="app-header-titulo" text="RelojUNA" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblUsuario" styleClass="app-header-usuario" text="Bienvenido" />
                <Button fx:id="btnCerrarSesion" onAction="#handleCerrarSesion"
                        styleClass="boton-header" text="Cerrar sesion" />
            </HBox>
            <Region styleClass="franja-institucional" />
        </VBox>
    </top>

    <center>
        <StackPane styleClass="contenido-pagina">
            <VBox styleClass="contenedor-principal" alignment="CENTER">

                <VBox styleClass="encabezado-pagina">
                    <Label styleClass="titulo-pagina" text="Menu Principal" />
                    <Label styleClass="subtitulo-pagina"
                           text="Seleccione un modulo para continuar" />
                </VBox>

                <TilePane styleClass="grilla-modulos">

                    <Button fx:id="btnEmpleados" onAction="#handleEmpleados"
                            styleClass="tarjeta-modulo" text="Mantenimiento de Empleados" />

                    <Button fx:id="btnMarcas" onAction="#handleMarcas"
                            styleClass="tarjeta-modulo" text="Pantalla de Marcas" />

                    <Button fx:id="btnMantenimientoMarcas" onAction="#handleMantenimientoMarcas"
                            styleClass="tarjeta-modulo" text="Mantenimiento de Marcas" />

                    <Button fx:id="btnPlanilla" onAction="#handlePlanilla"
                            styleClass="tarjeta-modulo" text="Generacion de Planillas" />

                    <Button fx:id="btnConsulta" onAction="#handleConsulta"
                            styleClass="tarjeta-modulo" text="Consultas" />

                    <Button fx:id="btnReportes" onAction="#handleReportes"
                            styleClass="tarjeta-modulo" text="Modulo de Reportes" />

                </TilePane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>